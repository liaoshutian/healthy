.bar { position: fixed; left: 0; right: 0; bottom: 0; height: calc(110rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: #FFFDF6; display: flex; box-shadow: 0 -2rpx 16rpx rgba(94, 158, 42, 0.08); }
.item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #8A9479; font-size: 20rpx; }
.item.on { color: #5E9E2A; font-weight: 600; }
.icon { font-size: 40rpx; line-height: 1.2; filter: grayscale(0.7); opacity: 0.75; }
.item.on .icon { filter: none; opacity: 1; }
.center { position: relative; }
.plus { width: 100rpx; height: 100rpx; margin-top: -48rpx; border-radius: 50%; background: #7DBE3C; color: #fff; font-size: 60rpx; line-height: 96rpx; text-align: center; box-shadow: 0 8rpx 20rpx rgba(94, 158, 42, 0.35); border: 6rpx solid #FFFDF6; }
