.seg { display: flex; background: var(--line); border-radius: 999rpx; padding: 6rpx; margin-bottom: 24rpx; }
.seg-item { flex: 1; text-align: center; padding: 12rpx 0; border-radius: 999rpx; color: var(--muted); }
.seg-item.on { background: #fff; color: var(--lime-deep); font-weight: 600; }
.nav { font-size: 44rpx; padding: 0 24rpx; color: var(--lime-deep); }
.week { display: flex; color: var(--muted); font-size: 22rpx; }
.week text { flex: 1; text-align: center; }
.grid { display: flex; flex-wrap: wrap; }
.cell { width: 14.28%; height: 96rpx; display: flex; flex-direction: column; align-items: center; padding-top: 8rpx; box-sizing: border-box; border-radius: 16rpx; }
.cell.today { background: var(--lime-soft); }
.cell.blank { visibility: hidden; }
.num { font-size: 26rpx; }
.dots { display: flex; align-items: center; gap: 4rpx; height: 30rpx; }
.dot { display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%; }
.dot.green { background: var(--lime); }
.dot.blue { background: var(--sky); }
.mini { font-size: 18rpx; }
.legend { display: flex; justify-content: space-between; }
.chips { white-space: nowrap; }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, 0.35); z-index: 100; display: flex; align-items: flex-end; }
.sheet { width: 100%; max-height: 70vh; overflow-y: auto; background: #FFFDF6; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 32rpx calc(140rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
