.photo-wrap { position: relative; margin-bottom: 24rpx; }
.photo { width: 100%; height: 480rpx; border-radius: 28rpx; display: block; }
.pin { position: absolute; width: 44rpx; height: 44rpx; margin: -22rpx 0 0 -22rpx; border-radius: 50%; background: var(--lime); color: #fff; font-size: 24rpx; text-align: center; line-height: 44rpx; border: 4rpx solid #fff; }
.item { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.num { display: inline-block; width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; border-radius: 50%; background: var(--lime); color: #fff; font-size: 20rpx; margin-right: 10rpx; }
.item-name { font-size: 30rpx; font-weight: 600; }
.step { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--lime-soft); color: var(--lime-deep); font-size: 40rpx; text-align: center; line-height: 68rpx; }
.score { background: var(--line); border-radius: 20rpx; padding: 20rpx; }
.score.lit { background: var(--lime-soft); color: var(--lime-deep); }
.page { padding-bottom: 240rpx; }
