.li { padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.in { background: var(--cream); border-radius: 16rpx; padding: 16rpx 20rpx; }
.bars { display: flex; align-items: flex-end; gap: 12rpx; height: 200rpx; overflow-x: auto; }
.bar-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; min-width: 56rpx; }
.bar { width: 28rpx; background: var(--lime); border-radius: 8rpx 8rpx 0 0; }
.tl { display: flex; gap: 16rpx; padding: 14rpx 0; }
.tl-icon { font-size: 36rpx; }
.thumb { width: 140rpx; height: 140rpx; border-radius: 16rpx; margin: 12rpx 12rpx 0 0; }
.summary-canvas { position: fixed; left: -9999px; top: 0; }
