<view class="page">
  <view class="card head">
    <view class="small muted">当前</view>
    <view class="big">{{tierName}}</view>
    <view wx:if="{{d.days_left !== null}}" class="small">还有 {{d.days_left}} 天</view>
    <view class="tiny muted mt">会员 ID：{{d.member_id}} <text class="copy" bindtap="copyId">复制</text></view>
  </view>

  <view class="card">
    <view class="card-title">输入兑换码</view>
    <view class="row gap">
      <input class="code flex1" placeholder="10 位兑换码" value="{{code}}" bindinput="onCode" maxlength="20" />
      <view class="btn small {{redeeming ? 'disabled' : ''}}" bindtap="redeem">兑换</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">今天的识别次数</view>
    <view wx:for="{{quotas}}" wx:key="feature" class="between q">
      <text>{{item.label}}</text>
      <text class="muted">{{item.used}} / {{item.limit === null ? '不限' : item.limit}}（{{item.period === 'day' ? '每天' : '每月'}}）</text>
    </view>
    <view class="tiny muted mt">次数用完也能手动记，永远不会记不了</view>
  </view>

  <view class="card">
    <view class="table">
      <view class="tr th">
        <view class="td first"></view>
        <view wx:for="{{d.benefits.tiers}}" wx:key="code" class="td {{d.tier === item.code ? 'cur' : ''}}">{{item.name}}<view wx:if="{{item.coming_soon}}" class="tiny muted">敬请期待</view></view>
      </view>
      <view wx:for="{{d.benefits.rows}}" wx:key="key" class="tr {{highlight === item.key ? 'hl' : ''}}">
        <view class="td first">{{item.label}}</view>
        <view class="td">{{item.free}}</view>
        <view class="td">{{item.pro}}</view>
        <view class="td">{{item.max}}</view>
      </view>
    </view>
  </view>
</view>
