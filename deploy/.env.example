# 复制成 .env 后填写。不要把 .env 提交到仓库。
ENV=prod
POSTGRES_PASSWORD=换成一个长随机密码
JWT_SECRET=换成一个长随机字符串
ADMIN_TOKEN=管理后台口令，长一点
PUBLIC_BASE_URL=https://api.rexliao.cn

# 微信小程序
WX_APPID=wxbe81a96f3114c5f3
WX_SECRET=
# 订阅消息模板 ID（小程序后台 → 订阅消息 里的“日程提醒”模板，编号 46076）；规律小事和吃药提醒共用这一个
WX_TMPL_ROUTINE=neMAvVxEK1crzbttU9OOFdmTbRNXJXwZCUOGBU0vaos
WX_MINIPROGRAM_STATE=formal

# 图片存在本机 deploy/data/uploads，不需要额外配置

# 看图：ChatGPT，必须走我们自己服务器上的中转（OpenAI 兼容接口），不直连 api.openai.com
# 留空则不调用 ChatGPT，直接用通义千问 VL
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6.1-terra
OPENAI_TEXT_MODEL=gpt-6.1-terra
# 推理强度 none/low/medium/high；换回 gpt-4.1 / gpt-4o 这类老模型时留空
OPENAI_REASONING_EFFORT=low
QWEN_API_KEY=
QWEN_VISION_MODEL=qwen-vl-max
# 纯文字：主模型 ChatGPT（OPENAI_TEXT_MODEL），失败或没配中转时用 DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

TRIAL_DAYS=7
