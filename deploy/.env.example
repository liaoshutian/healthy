# 复制成 .env 后填写。不要把 .env 提交到仓库。
ENV=prod
POSTGRES_PASSWORD=换成一个长随机密码
JWT_SECRET=换成一个长随机字符串
ADMIN_TOKEN=管理后台口令，长一点
PUBLIC_BASE_URL=https://api.rexliao.cn

# 微信小程序
WX_APPID=wxbe81a96f3114c5f3
WX_SECRET=
# 订阅消息模板 ID（小程序后台 → 订阅消息 里选模板后填写）
WX_TMPL_ROUTINE=
WX_TMPL_MEDICATION=
WX_MINIPROGRAM_STATE=formal

# 图片存储：cos 或 local
STORAGE_BACKEND=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=qingning-1250000000

# 看图：ChatGPT 官方 API；失败自动切换到通义千问 VL
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
# 国内服务器直连 OpenAI 可能不通，可填你的转发地址
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=
QWEN_VISION_MODEL=qwen-vl-max
# 纯文字：DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

TRIAL_DAYS=7
